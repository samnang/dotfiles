#!/usr/bin/env bash

region="${AWS_REGION:-ap-southeast-1}"

selected=$(
  aws ec2 describe-instances \
    --region "$region" \
    --filters "Name=instance-state-name,Values=running" \
    --output json |
    jq -r '
    .Reservations[].Instances[] |
    [
      ((.Tags // []) | map(select(.Key == "Name")) | .[0].Value // "-"),
      .InstanceId,
      (
        (.LaunchTime | sub("\\+00:00$"; "Z") | fromdateiso8601) as $launched |
        (now - $launched) as $age |
        if $age < 60 then
          "\($age | floor)s ago"
        elif $age < 3600 then
          "\($age / 60 | floor)m ago"
        elif $age < 86400 then
          "\($age / 3600 | floor)h ago"
        elif $age < 2592000 then
          "\($age / 86400 | floor)d ago"
        elif $age < 31536000 then
          "\($age / 2592000 | floor)mo ago"
        else
          "\($age / 31536000 | floor)y ago"
        end
      )
    ] | @tsv
  ' |
    sort -t $'\t' -k1,1 |
    column -t -s $'\t' |
    fzf \
      --height=40% \
      --reverse \
      --border=rounded \
      --prompt="Instance > " \
      --info=inline
)

[ -z "$selected" ] && exit 0

instance_name=$(printf '%s\n' "$selected" | awk '{print $1}')
instance_id=$(printf '%s\n' "$selected" | awk '{print $2}')

echo "Connecting to ${instance_name} (${instance_id})..."

exec aws ssm start-session \
  --region "$region" \
  --target "$instance_id"
